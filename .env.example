# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hcm_lite

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- First run (optional): if set, the setup screen can skip email/password ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI assistant (any OpenAI-compatible API with tool calling) ---
# Groq (free):   https://api.groq.com/openai/v1  model: llama-3.3-70b-versatile
# Gemini (free): https://generativelanguage.googleapis.com/v1beta/openai  model: gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Pakistan = UTC+5 = 300 minutes
TZ_OFFSET_MIN=300
